#!/bin/sh
# Avatar overlay: system Python + GTK4 + gtk4-layer-shell (must be preloaded before libwayland).
ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"
export LD_PRELOAD="/usr/lib/libgtk4-layer-shell.so${LD_PRELOAD:+:$LD_PRELOAD}"
# GTK's default Vulkan renderer costs ~108% of a core while she's visible on NVIDIA here, GL ~32%, same picture
export GSK_RENDERER="${GSK_RENDERER:-ngl}"
exec python3 "$ROOT/avatar/avatar.py" "$@"
