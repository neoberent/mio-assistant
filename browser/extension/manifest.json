{
  "manifest_version": 3,
  "name": "Mio",
  "version": "1.2.0",
  "description": "Lets Mio, your desktop assistant, read pages and control tabs and videos by voice. Talks only to Mio on this PC.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "history",
    "sessions",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116"
}